# AI Daily Digest 环境变量配置模板
# 复制此文件为 .env 并填写你的 API Key

# ===== 外部 AI API 配置（可选，不配置则使用 WorkBuddy 内置模型）=====

# Gemini API Key（推荐，免费额度充足）
# 获取地址：https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIzaSy...

# OpenAI API Key（或 OpenAI 兼容接口）
# OPENAI_API_KEY=sk-...

# OpenAI API Base URL（可选，用于自定义端点）
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_BASE=https://api.deepseek.com/v1  # DeepSeek 示例

# OpenAI Model（可选，默认 gpt-4o-mini）
# OPENAI_MODEL=gpt-4o-mini

# ===== 其他配置 =====

# RSS 抓取超时时间（秒，默认 10）
# RSS_TIMEOUT=10

# 并发抓取线程数（默认 10）
# MAX_WORKERS=10
